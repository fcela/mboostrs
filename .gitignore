.idea/
.vscode/

# OS
.DS_Store

# Profiling
perf.data*
flamegraph.svg
benches/results/
.antigravitycli/
restart.sh
docs/book/exports/notebooks/
.antigravitycli/

# Agent worktrees (transient, created by subagents)
.claude/worktrees/

# Demo artifacts written by usage/plotting_serialization.ipynb and
# usage/quickstart.ipynb when the book executes. Regenerated on every build
# with different bytes, so tracking them dirties the tree after each run.
docs/book/usage/risk_path.pdf
docs/book/usage/risk_path.png
docs/book/usage/quickstart_fit.json

# Published third-party article supplements downloaded as inputs to the
# commuting-zone study. The 61-page appendix to Chetty et al., "The Association
# between Income and Life Expectancy in the United States, 2001-2014" (JAMA
# 2016) is American Medical Association material, redistributable only on their
# terms, and nothing in the repository reads it — the study uses the Health
# Inequality Project's data tables, not the appendix. The second name is a 4KB
# HTML error page a download saved under a .pdf extension.
data/hp_02/jama_supplement.pdf
studies/**/jama2016_online_supplement.pdf
benches/.cache/
.feynman/cache/
catboost_info/

# Raw per-draw benchmark run archives are assets of the GitHub release
# benchmark-raw-archives-1, not tracked files. docs/book/benchmarks/raw_archives.json
# lists each one with its size, SHA-256 and regenerating command (issue #812).
docs/book/benchmarks/**/*.jsonl.xz
docs/book/benchmarks/**/*.jsonl.gz
