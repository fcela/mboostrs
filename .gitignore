# Rust build artifacts
target/

# Contributor / agent guide (kept locally, not in repo)
AGENTS.md

# Compiled object files
*.o

# Shared / dynamic libraries
*.so
*.dylib*
*.dll

# R installation metadata generated beside compiled objects
mboostrs/src/symbols.rds

# Python bytecode & caches
*.pyc
__pycache__/
*.egg-info/
*.egg
*.whl
dist/

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/

# AI agent working memory. The writing guide is contributor documentation;
# the remaining session notes stay local.
.remember/*
!.remember/.gitignore
!.remember/WRITING_STYLE_GUIDE.md
.bob/
/.roborev/
.omo/

# Jupyter virtual documents
.virtual_documents/

# R CMD check artifacts
*.Rcheck/
*.Rcheck/

# R package generated files
mboostrs/src/Makevars

# Docs build
docs/book/_build/
_build/
docs/book/exports/*.pdf
# The notebook download bundle is built by build-html.sh beside the rendered
# site and published with it. A tracked copy cost ~0.6 MB of new history on
# every docs change, since zip content does not delta-compress.
docs/book/exports/*.zip

# npm / mermaid
node_modules/
chrome-headless-shell/

# Linters / type-checkers
.ruff_cache/
.mypy_cache/
.pytest_cache/

