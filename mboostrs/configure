#!/bin/sh
# configure script for the mboostrs R package.
# Builds the Rust static library, then writes a Makevars that force-loads it
# into mboostrs.so so R_init_mboostrs (and all wrap__ routines) are present.

# Locate the workspace root (the dir containing crates/mboostrs-r). R CMD
# INSTALL runs this script from the package dir, which may sit at various
# depths relative to the workspace, so search upward instead of assuming a
# fixed number of "../" hops. MBOOSTRS_ROOT can override the search.
if [ -z "$MBOOSTRS_ROOT" ]; then
    d="$(cd "$(dirname "$0")" && pwd)"
    while [ "$d" != "/" ]; do
        if [ -d "$d/crates/mboostrs-r" ]; then
            MBOOSTRS_ROOT="$d"
            break
        fi
        d="$(dirname "$d")"
    done
fi
if [ -z "$MBOOSTRS_ROOT" ] || [ ! -d "$MBOOSTRS_ROOT/crates/mboostrs-r" ]; then
    echo "ERROR: could not locate crates/mboostrs-r above $(dirname "$0"); set MBOOSTRS_ROOT"
    exit 1
fi
export MBOOSTRS_ROOT
CRATE_DIR="$MBOOSTRS_ROOT/crates/mboostrs-r"

echo "configure: building Rust staticlib (-p mboostrs-r) from $CRATE_DIR"
# `R CMD check`'s Rust-compilation check greps the install log for an
# explicit "rustc X.Y.Z" line ahead of cargo's own "Compiling" output, to
# confirm which compiler produced the binary. `cargo build` alone doesn't
# print this, so report it ourselves first.
rustc --version || {
    echo "ERROR: rustc not found on PATH"
    exit 1
}
( cd "$CRATE_DIR" && cargo build --release -p mboostrs-r ) || {
    echo "ERROR: cargo build failed"
    exit 1
}

LIBA="$MBOOSTRS_ROOT/target/release/libmboostrs_r.a"
if [ ! -f "$LIBA" ]; then
    echo "ERROR: $LIBA not found after build"
    exit 1
fi

UNAME_S=$(uname -s)
if [ "$UNAME_S" = "Darwin" ]; then
    # force_load pulls every symbol (incl. R_init_mboostrs) into mboostrs.so
    FORCE="-Wl,-force_load,$LIBA"
    EXTRA_LIBS="-framework Security -framework CoreFoundation -liconv"
else
    FORCE="-Wl,--whole-archive $LIBA -Wl,--no-whole-archive"
    EXTRA_LIBS=""
fi

cat > src/Makevars <<ENDOFMAKEVARS
# Generated by ./configure -- do not edit.
OBJECTS = init.o
PKG_LIBS = $FORCE -lpthread -ldl -lm $EXTRA_LIBS
ENDOFMAKEVARS

# The .so links init.o and force-loads the Rust staticlib, but make only tracks
# init.o — so when only the Rust crate changes, make sees init.o unchanged and
# skips relinking, leaving a stale .so (missing newly added symbols). Remove the
# stale objects/lib so the package always relinks against the fresh staticlib.
rm -f src/mboostrs.so src/*.o

echo "configure: done. force_load $LIBA"
